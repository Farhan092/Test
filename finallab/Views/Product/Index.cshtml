﻿@model List<FinalLabCF.Models.Product>
@{
    ViewBag.Title = "Index";
}



<h2>Product Information</h2>
<hr />
<br />
<br />



<table class="table table-hover">
    <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        

       
    </tr>
    @if (Model != null)
    {
        foreach (var items in Model)
        {
            <tr>
                <td>@items.Name</td>
                <td>@items.Category.CategoryType</td>
                <td>@items.Price</td>
                
            </tr>
        }
    }
</table>



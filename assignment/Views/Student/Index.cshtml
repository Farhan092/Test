@model List<assignment.Context.Student>
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>



<table class="table table-hover">
    <tr>
        <th>Name</th>
        <th>CGPA</th>
        <th>Admission Date </th>
        <th>Department Name</th>


    </tr>
    @if (Model != null)
    {
        foreach (var items in Model)
        {
            <tr>
                <td>@items.Name</td>
                <td>@items.Cgpa</td>
                <td>@items.AdmissionDate</td>
                <td>@items.Department.DepName</td>



            </tr>
        }
    }
</table>
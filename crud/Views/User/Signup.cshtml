@using CRUDEF.Context
@model CRUDEF.Context.User  
@{
    ViewBag.Title = "Signup";
}

<h2>Signup</h2>
<style>
    .rederror {
        color: red;
        font-size: xx-small;
    }
</style>


@using (Html.BeginForm("SignUp", "User", FormMethod.Post))
{
    <div class="container">

        <div class="form-group">
            @Html.LabelFor(x => x.Username)
            @Html.TextBoxFor(x => x.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.Username, "", new { @class = "rederror" })
        </div>
        <br />
        <div>
            @Html.LabelFor(x => x.Password)
            @Html.EditorFor(x => x.Password, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "rederror" })
        </div>



        <div>
            @Html.LabelFor(x => x.RePassword)
            @Html.EditorFor(x => x.RePassword, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(x => x.RePassword, "", new { @class = "rederror" })
        </div>

        <div class="form-group">
            @Html.LabelFor(x => x.Type)
            @Html.DropDownListFor(x => x.Type, new SelectList(Enum.GetValues(typeof(UserType))),"---select---", new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.Type , "", new { @class = "rederror" })
        </div>
        <br />

        <div>
            <input id="SignUpBtn" type="submit" value="Sign Up" class="btn btn-primary" />
        </div>











    </div>







}